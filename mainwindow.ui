        <property name="styleSheet">
         <string notr="true">QPushButton {
    background-color: #0A2472; /* Bleu foncé */
    border: 2px solid #1E90FF; /* Bordure bleu clair */
    border-radius: 8px; /* Coins arrondis */
    color: white; /* Texte blanc */
    font-size: 16px; /* Taille de police */
    font-weight: bold; /* Texte en gras */
    padding: 8px 16px; /* Espacement interne */
    min-width: 100px; /* Largeur minimale */
    min-height: 35px; /* Hauteur minimale */
    transition: all 0.2s ease-in-out; /* Douce transition */
}

/* Effet au survol */
QPushButton:hover {
    background-color: #1E90FF; /* Bleu plus clair */
    border: 2px solid #0A2472; /* Bordure plus foncée */
    color: #ffffff; /* Texte blanc */
}

/* Effet lorsqu'on appuie sur le bouton */
QPushButton:pressed {
    background-color: #153A69; /* Bleu foncé quand pressé */
    border: 2px solid #0A2472; /* Bordure accentuée */
    color: #C0DFFD; /* Texte légèrement éclairci */
    padding-top: 10px; /* Effet de relief */
    padding-bottom: 6px; /* Simule l'enfoncement du bouton */
}

/* Effet de focus (quand on navigue avec Tab ou clique sur le bouton) */
QPushButton:focus {
    border: 2px solid #FFD700; /* Bordure dorée pour mettre en avant */
    background-color: #0A2472; /* Fond bleu foncé */
}
</string>
