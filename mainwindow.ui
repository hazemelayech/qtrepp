        <property name="styleSheet">
         <string notr="true">QPushButton {
    background-color: transparent;
    font-size: 18px;
    border-radius: 20px;
    padding: 10px 20px;
    border: none;
    transition: background 0.3s ease-in-out;
}

QPushButton::before {
    content: &quot;🔍&quot;; /* Icône de loupe intégrée */
    font-size: 20px;
    margin-right: 8px;
}

QPushButton:hover {
    background-color: rgb(0, 102, 122);
}

QPushButton:pressed {
    background-color: rgb(0, 85, 102);
}
QPushButton#searchButton {
    background-color: rgb(0, 153, 195);
    color: white;
    font-size: 14px;
    border-radius: 10px;
    padding: 8px 15px;
    border: none;
}

/* Effet au survol */
QPushButton#searchButton:hover {
    background-color: rgb(0, 102, 122);
}
