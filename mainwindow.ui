        <property name="styleSheet">
         <string notr="true">QLineEdit {
    background-color: rgb(240, 248, 255);
    border: 2px solid rgb(0, 153, 195);
    border-radius: 20px;
    padding: 10px 40px; /* Espace pour l'icône */
    font-size: 16px;
    color: rgb(0, 102, 122);
    selection-background-color: rgb(189, 211, 232);
    min-width: 250px;
    qproperty-placeholderText: &quot; Rechercher...&quot;; /* Ajout d'un placeholder avec icône */
}

QLineEdit:focus {
    border: 2px solid rgb(0, 102, 122);
    background-color: rgb(255, 255, 255);
}
